{
  "name": "dx-jquery",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "prebuild": "devextreme-license --non-modular --out src/devextreme-license.js --force",
    "build": "npm run lint",
    "lint-html": "prettier --check src/*.html src/*.js src/*.css",
    "lint-js": "eslint .",
    "lint-css": "stylelint src/**/*.css --allow-empty-input",
    "lint": "npm-run-all -p -c lint-js lint-css lint-html"
  },
  "devDependencies": {
    "@babel/core": "^7.22.1",
    "@babel/eslint-parser": "^7.21.8",
    "eslint": "9.18.0",
    "eslint-config-devextreme": "1.1.10",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "htmlhint": "^1.1.4",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "stylelint": "^15.6.1",
    "stylelint-config-standard": "^33.0.0"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "devextreme": "26.1.2-beta",
    "devextreme-dist": "26.1.2-beta",
    "devextreme-exceljs-fork": "4.4.9",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "jquery": "^3.7.1"
  }
}
